{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@1.0.6"],
      "autoApprove": []
    },
    "fetch": {
      "command": "uvx",
      "args": ["--from", "mcp-server-fetch==0.2.1", "mcp-server-fetch"],
      "env": {
        "FETCH_TIMEOUT": "30s"
      }
    }
  }
}
